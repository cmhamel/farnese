WHITESPACE = _{ " " | "\t" }

alpha      = { 'a'..'z' | 'A'..'Z' }
alpha_num  = { 'a'..'z' | 'A'..'Z' | '0'..'9' }
operator   = { "+" | "-" | "*" | "/" | "^" }
//unicode    = { "λ" }

KEYWORD = {
  KEYWORD_WORD ~ !(alpha | alpha_num | "_" | "!")
}
KEYWORD_WORD = { 
  "abstract type"  | 
  "const"          |
  "end"            |
  "export"         |
  "function"       |
  "global"         |
  "import"         |
  "macro"          |
  "module"         |
  "mutable"        |
  "primitive type" |
  "quote"          |
  "public"         |
  "return"         |
  "struct"         |
  "using"          |
  "where"
}

//int = _{ ("+" | "-")? ~ ASCII_DIGIT+ }
int = @{ ASCII_DIGIT+ }
Float64 = { int ~ "." ~ (ASCII_DIGIT*)? ~ (^"e" ~ int)? }
Int = { int }
String = @{
    "\"" ~ (!"\"" ~ ANY)* ~ "\""
}
Symbol = @{
    ":" ~ Identifier
}

RawIdentifier = @{
    (alpha | "_") ~
    (alpha_num | "!" | "_")*
}

Identifier = @{ !KEYWORD ~ RawIdentifier }

Primitive = {
    Float64 |
    Int     |
    String  | 
    Symbol
}
Assignment = { Identifier ~ "=" ~ Expr ~ (NEWLINE | ";")? }

Call = {
    Identifier ~ "(" ~
    (Statement ~ ("," ~ Statement)*)? ~
    ")"
}

TypedArg = {
  Identifier ~ "::" ~ Identifier
}
FuncArg = _{ TypedArg | Identifier }
FuncBody = _{ (Statement | NEWLINE)* }
//FuncBody = { Statement* }
ComplexFuncDef = {
  "function" ~ (Identifier | operator) ~ "(" ~
    (FuncArg ~ ("," ~ FuncArg)*)? ~
  ")" ~ NEWLINE? ~
  //Statement* ~
  FuncBody ~
  "end" ~ NEWLINE?
}

SimpleFuncDef = {
  (Identifier | operator) ~ "(" ~ 
    (FuncArg ~ ("," ~ FuncArg)*)? ~
  ")" ~ "=" ~ Statement
}

AbstractType = {
  "abstract type" ~ Identifier ~ ("<:" ~ Identifier)? ~ "end"
}
PrimitiveType = {
  "primitive type" ~ Identifier ~ ("<:" ~ Identifier)? ~ int ~ "end"
}

//SingleLineComment = { "#" ~ ANY* ~ NEWLINE }
SingleLineComment = {
    "#" ~ (!NEWLINE ~ ANY)* ~ NEWLINE
}

Atom = _{ Call | Identifier | Primitive | "(" ~ Expr ~ ")" }
ExprTerm = _{ operator | Atom }
Expr = { ExprTerm+ }

Statement = {
    AbstractType      |
    PrimitiveType     |
    ComplexFuncDef    |
    SimpleFuncDef     |
    Assignment        |
    Call              |
    SingleLineComment |
    Expr
}

//Program = { SOI ~ (Statement ~ NEWLINE?)* ~ EOI }
Program = { SOI ~ (Statement | NEWLINE)* ~ EOI }